# ==============================================================================
# Local-First Real-Time Voice Agent Configuration (.env.example)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# --- Audio Input / Output ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SAMPLES=512          # 32ms frames @ 16kHz (compatible with Silero VAD)
AUDIO_INPUT_DEVICE_INDEX=        # Leave blank for OS default microphone
AUDIO_OUTPUT_DEVICE_INDEX=       # Leave blank for OS default speaker

# --- Voice Activity Detection (VAD) & Endpointing ---
VAD_MODEL=silero
VAD_THRESHOLD=0.5                # Speech probability threshold (0.0 to 1.0)
VAD_MIN_SPEECH_DURATION_MS=200   # Ignore speech transients shorter than this
VAD_MIN_SILENCE_DURATION_MS=500  # Silence duration to trigger turn finalization (endpointing)
VAD_SPEECH_PAD_MS=100            # Padding added to speech chunks

# --- Noise Suppression (Optional) ---
NOISE_SUPPRESSION_ENABLED=false  # Toggle DTLN / spectral noise suppression
NOISE_SUPPRESSION_ENGINE=none    # Options: none, dtln, noisereduce

# --- Speech-to-Text (STT) ---
STT_ENGINE=faster-whisper        # Options: faster-whisper, whisper-cpp
STT_MODEL_SIZE=base.en           # Options: tiny.en, base.en, small.en
STT_DEVICE=cpu                   # Hardware acceleration: cpu (or cuda if available)
STT_COMPUTE_TYPE=int8            # CPU quantization: int8, float32
STT_BEAM_SIZE=1                  # 1 for greedy/fastest streaming inference
STT_CPU_THREADS=4                # Max worker threads allocated to CTranslate2 (matched to physical CPU cores)

# --- CPU Optimization & Concurrency Limits (AMD Ryzen 5 4-core budget) ---
ONNX_INTRA_OP_THREADS=2          # Parallelism within an operator for ONNX sessions
ONNX_INTER_OP_THREADS=1          # Parallelism between operators
EXECUTOR_MAX_WORKERS=2           # Bounded worker threads keeping C++ inference off asyncio loop

# --- Primary Large Language Model (Main LLM) ---
LLM_PROVIDER=ollama              # Options: ollama, llama-cpp, openai-compatible
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=150
LLM_SYSTEM_PROMPT="You are a concise, responsive, and natural conversational voice assistant. Keep answers brief (1-3 sentences) unless asked for details."

# --- Intent Readiness & Filler Engine (SLM) ---
FILLER_ENABLED=true
FILLER_PROVIDER=ollama           # Fast local runner for small model
FILLER_MODEL=qwen2.5:0.5b        # Ultra-lightweight model for quick acknowledgments
FILLER_MAX_TOKENS=15
FILLER_TEMPERATURE=0.3
INTENT_DETECTOR_MIN_WORDS=3      # Minimum tokens before checking intent readiness
INTENT_DETECTOR_THRESHOLD=0.75   # Confidence score threshold to trigger early filler

# --- Text-to-Speech (TTS) ---
TTS_ENGINE=piper                 # Options: piper, kokoro-onnx
TTS_PIPER_BINARY=piper           # Path to piper executable or python binding
TTS_VOICE_MODEL=en_US-lessac-medium.onnx
TTS_SAMPLE_RATE=22050

# --- Turn Management & Barge-in ---
BARGE_IN_ENABLED=true            # Immediately cancel agent speech when user speaks
BARGE_IN_VAD_FRAMES=3            # Consecutive speech frames required before cutting off audio

# --- Observability & Security ---
LOG_LEVEL=INFO
ENABLE_STAGE_TIMESTAMPS=true
SAVE_AUDIO_RECORDINGS=false      # Set to false to avoid saving user audio locally
METRICS_EXPORT_PROMETHEUS=false
